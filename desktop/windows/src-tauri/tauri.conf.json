{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Do Stuff",
  "version": "2.7.1",
  "identifier": "com.dostuff.desktop",
  "build": {
    "beforeDevCommand": "npm run sync-web",
    "beforeBuildCommand": "npm run sync-web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Do Stuff",
        "width": 720,
        "height": 720,
        "minWidth": 350,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
